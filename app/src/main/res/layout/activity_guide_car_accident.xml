<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:fitsSystemWindows="true"
        android:background="@color/primary">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="20dp"
            android:text="Emergency Guide"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardPreventCornerOverlap="false">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_bg_car_accident" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Offline Guide: Car Accident Emergency"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHO is involved?"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/arrowWho"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="The Rescuer (You): Check your own safety first. The Victims: Drivers, passengers..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• The Rescuer (You): Check your own safety first. Do not become a second victim.\n\n• The Victims: Drivers, passengers, pedestrians, or motorcyclists involved.\n\n• Emergency Services: Royal Malaysia Police (PDRM), Fire and Rescue Department (Bomba), and Medical Teams (Ambulance).\n\n• The Witnesses: Gather contact details of anyone who saw the accident for insurance and police reports."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHAT happened &amp; WHAT to do?"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/arrowWhat"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Switch on hazard lights and place warning triangle. Turn off ignitions. Do not move injured..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="What happened:\nA vehicle collision causing potential injuries, traffic obstruction, or fire hazards.\n\nWhat to DO Immediately:\n• Switch on hazard lights and place a warning triangle 50 meters behind the vehicle.\n• Turn off the car ignitions to prevent fire risks.\n• Check for injuries and consciousness among all victims.\n\nWhat NOT to DO:\n❌ DO NOT move critically injured victims unless there is an immediate threat of fire or explosion (risk of permanent spinal damage).\n❌ DO NOT argue or fight with other drivers on the road.\n❌ DO NOT accept unauthorized private tow truck services (ulat tunda) on-site."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHERE did it happen?"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <ImageButton
                            android:id="@+id/arrowWhere"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Move to a safe zone behind guardrails. Identify landmarks/KM markers. Report to Balai Polis Trafik..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="On-Site Safety: Move all uninjured people to a safe zone behind the highway guardrails or off the main road. Never stand between or behind damaged vehicles.\n\nPinpoint Location: Identify your exact location using landmarks, highway kilometer markers (e.g., PLUS Highway KM markers), or street names.\n\nWhere to Report: Proceed to the nearest Traffic Police Station (Balai Polis Trafik) within the district where the accident occurred to lodge a report."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHEN to react?"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <ImageButton
                            android:id="@+id/arrowWhen"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="First 60 Seconds: Secure scene. Within 5 Mins: Call 999. Within 24 Hours: Report to police..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• First 60 Seconds (Golden Minute):\nSecure the scene, turn on hazards, and assess the danger (check for leaking fuel or smoke).\n\n• Within 5 Minutes:\nCall 999 or use the JER App SOS button if there are injuries or blocked traffic.\n\n• Within 24 Hours:\nYou must lodge an official police report. Failure to do so within 24 hours is an offense under Malaysian law and will void insurance claims."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHY are these steps critical?"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/arrowWhy"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Secondary crashes are fatal. Moving victims risks paralysis. Photos are crucial for claims..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Why secure the scene first?\nSecondary crashes are highly common and often more fatal than the initial accident.\n\n• Why leave victims in the vehicle?:\nSudden movement can sever the spinal cord if the victim has an undetected neck or back injury, causing permanent paralysis.\n\n• Why take photos before moving cars?:\nAccurate visual evidence of the vehicle positions, road lines, and damages is crucial for the police investigation and insurance (Own Damage or Third-Party) claims."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerHow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/arrowHow"
                            android:layout_centerVertical="true"
                            android:text="HOW to handle the situation? (Step-by-Step)"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <ImageButton
                            android:id="@+id/arrowHow"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewHow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="[ Step 1: Secure Scene ] ➔ [ Step 2: Call 999/JER ] ➔ [ Step 3: Document Evidence ]..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentHow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#E9ECEF"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginBottom="12dp"
                            android:text="[ Step 1: Secure Scene ] ➔ [ Step 2: Call 999/JER ] ➔ [ Step 3: Document Evidence ]"
                            android:textColor="#495057"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 1: Secure Scene &amp; Manage Traffic"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="If the accident is minor and no one is injured, move the vehicles to the emergency lane only after taking quick photos to avoid causing severe traffic congestion."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Step 2: Call 999 / JER App"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dial 999 or tap JER Emergency Contacts. State clearly: Location, number of vehicles involved, and number of injured victims."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Step 3: Document Evidence (For Police &amp; Insurance)"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Take clear photos of the damage on all vehicles.\n\n• Take wide-angle photos showing the final positions of the vehicles relative to the road lanes.\n\n• Snap photos of the other driver’s Driver’s License and MyKad/Passport."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="20dp"
                android:text="© 2026 JER - Chia Jing Xian. All rights reserved."
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>