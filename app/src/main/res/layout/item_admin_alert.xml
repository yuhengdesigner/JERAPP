<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvVictimName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Full Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvEmergencyTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_tag_red"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="FIRE"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#EEEEEE" />

        <TextView
            android:id="@+id/tvVictimGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚧ Gender: N/A"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvVictimPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📞 +60 12-345 6789"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvVictimEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✉️ user@email.com"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvVictimAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 123, Jalan Bahagia, Batu Pahat, Johor"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/secondary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text='@{"Lat: " + alert.userLat + ", Lng: " + alert.userLng}' />

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Arrived"
            android:textColor="#2196F3"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#EEEEEE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReceive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Receive"
                android:textColor="@color/background"
                android:backgroundTint="#D32F2F"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResolve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Resolve"
                android:backgroundTint="#388E3C" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>