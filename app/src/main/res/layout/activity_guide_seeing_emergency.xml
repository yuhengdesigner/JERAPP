<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:fitsSystemWindows="true"
        android:background="@color/primary">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="20dp"
            android:text="Emergency Guide"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardPreventCornerOverlap="false">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_bg_seeing_emergency" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Offline Guide: Seeing a Person in an Emergency"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/arrowWho"
                            android:text="WHO is involved &amp; WHO to coordinate?"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/arrowWho"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="The First Responder (You): Assess and call for help. The Bystanders: Command specific persons..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• The First Responder (You): Your role is to assess, call for help, and provide basic care within your limits. Do not put yourself in danger.\n\n• The Victim: The injured or sudden-illness casualty. Check if they are responsive.\n\n• The Bystanders: Do not let a crowd gather uselessly. Point directly at a specific person and command them: &quot;You in the blue shirt, call 999!&quot; or &quot;Go find an AED!&quot;"
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/arrowWhat"
                            android:text="WHAT is happening &amp; WHAT to do?"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/arrowWhat"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Follow the standard DRCAB lifesaving sequence. DO NOT rush blindly or give fluids to unconscious..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="What is happening:\nAn unconfirmed medical emergency, accident, or sudden collapse.\n\nWhat to DO Immediately:\nFollow the standard DRCAB lifesaving sequence:\n• Danger: Check for scene safety.\n• Response: Check if the victim is awake.\n• Circulation: Check for severe bleeding or pulse.\n• Airway: Ensure the breathing path is clear.\n• Breathing: Look for chest rise and fall.\n\nWhat NOT to DO:\n❌ DO NOT rush blindly to the victim without checking the surroundings (e.g., oncoming traffic, live wires, falling debris).\n❌ DO NOT move the person unless they are in immediate structural danger (prevents worsening spinal injuries).\n❌ DO NOT give fluids or food to an unconscious or semi-conscious person (causes choking/asphyxiation)."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/arrowWhere"
                            android:text="WHERE to evaluate &amp; WHERE to position?"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <ImageButton
                            android:id="@+id/arrowWhere"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Assess environment. Recovery position for unconscious but breathing. Track location street signs..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="The Environment: Assess the immediate location. Is it a highway, a flooded area, a confined space, or a public mall?\n\nVictim Positioning:\n• If breathing normally but unconscious: Place them in the Recovery Position (on their side).\n• If undergoing CPR: They must be placed flat on a hard, solid floor (not a mattress or couch).\n\nLocation Tracking: Look up at street signs, shop lots, or highway markers so you can give an exact location to the 999 dispatcher."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/arrowWhen"
                            android:text="WHEN to intervene &amp; WHEN to wait?"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <ImageButton
                            android:id="@+id/arrowWhen"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary"/>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="First 10 Seconds: Scan hazards. Within 1 Min: Check response. Check breathing every 2 mins..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• The First 10 Seconds:\nFreeze and scan the environment for hazards before taking a single step forward.\n\n• Within 1 Minute:\nCheck responsiveness and assign someone to call 999 or activate the JER App SOS speed dial.\n\n• Continuous Monitoring:\nCheck the victim's breathing every 2 minutes until paramedics arrive. If breathing stops, pivot immediately to the AED/CPR guidelines."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHY follow this system?"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/arrowWhy"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Scene safety prevents second victim. Delegating tasks breaks bystander effect. Breathing failure kills fast..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Why prioritize scene safety?\nIf a rescuer gets injured, there are now two victims instead of one, which completely paralyzes the rescue effort.\n\n• Why delegate tasks to specific bystanders?:\nIn a crisis, crowds experience the &quot;bystander effect&quot; where everyone assumes someone else is helping. Explicitly assigning tasks breaks this paralysis.\n\n• Why check breathing before anything else?:\nClinical death begins within 4 to 6 minutes after oxygen supply to the brain stops. Unaddressed breathing failure kills faster than almost any other injury."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerHow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/arrowHow"
                            android:layout_centerVertical="true"
                            android:text="HOW to manage the crisis? (Step-by-Step)"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <ImageButton
                            android:id="@+id/arrowHow"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewHow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="[ Step 1: Check Danger ] ➔ [ Step 2: Check Response ] ➔ [ Step 3: Shout &amp; Call 999 ]..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentHow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#E9ECEF"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginBottom="12dp"
                            android:text="[ Step 1: Check Danger ] ➔ [ Step 2: Check Response ] ➔ [ Step 3: Shout &amp; Call 999 ]"
                            android:textColor="#495057"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 1: Check for Danger (Scene Survey) &amp; Response"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Look for fire, leaking fuel, unstable structures, aggressive animals, or loose wires. Proceed only if 100% safe.\n\n• Tap the victim firmly on both shoulders and shout: &quot;Hello! Hello! Are you okay?&quot; If they move/speak, keep them comfortable and check for injuries. If no response, they are unconscious."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Step 2: Coordinate Emergency Dispatch"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap the Emergency Hotline button in the JER App or dial 999. State clearly to the operator: Your exact location, the number of victims, whether they are breathing, and any visible hazards nearby. Do not hang up until instructed."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Step 3: Pivot if Needed"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="If the victim is not breathing normally, immediately switch to the Find &amp; Use AED / CPR module within the application."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="20dp"
                android:text="© 2026 JER - Chia Jing Xian. All rights reserved."
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>