<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:fitsSystemWindows="true"
        android:background="@color/primary">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="20dp"
            android:text="Emergency Guide"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardPreventCornerOverlap="false">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_bg_fire_emergency" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Offline Guide: Fire Emergency"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHO is involved &amp; WHO to alert?"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/arrowWho"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="The Discoverer (You): Alert others immediately. The Occupants: Shout Fire! Fire! Call 999..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• The Discoverer (You): Your immediate priority is to alert others. Do not try to investigate or put out a growing fire alone.\n\n• The Occupants: Alert everyone in the building immediately by shouting &quot;FIRE! FIRE!&quot; or &quot;KEBAKARAN!&quot;\n\n• Emergency Services: Call 999 immediately to dispatch the Fire and Rescue Department (Bomba). Do not assume someone else has already made the call."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHAT is happening &amp; WHAT to do?"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/arrowWhat"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Activate fire alarm. Evacuate via stairs. DO NOT throw water on electric/oil fires, do not use lifts..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="What is happening:\nA fire breakout generating structural damage, high heat, and toxic smoke.\n\nWhat to DO Immediately:\n• Activate the building’s manual fire alarm system by smashing the nearest call point box.\n• Check door handles with the back of your hand before opening them; if hot, do not open.\n• Evacuate immediately using designated emergency escape routes.\n\nWhat NOT to DO:\n❌ DO NOT throw water on electrical or oil/grease fires (this causes violent explosive splattering or electrocution).\n❌ DO NOT delay evacuation to collect laptops, passports, or personal belongings.\n❌ DO NOT use elevators/lifts under any circumstances.\n❌ DO NOT hide in enclosed rooms like toilets or storerooms to escape the smoke."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHERE to go &amp; WHERE to isolate?"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/arrowWhere"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Exit Path: Stay low, follow KELUAR signs. Head to Assembly Point. If trapped, block door gaps..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• The Exit Path: Stay low to the ground where the air is cleaner. Follow illuminated exit signs (KELUAR) to the nearest stairwell.\n\n• The Assembly Point: Head directly to the designated Emergency Assembly Point outside, well clear of the building (e.g., an open parking lot or field).\n\n• If Trapped: Move to a room with an outdoor-facing window, close the door, and tightly seal all door gaps with wet towels or clothes to block crawling smoke."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHEN to react &amp; to stop fighting?"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/arrowWhen"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0-30 Seconds: Trigger alarm immediately. 30-Second Rule: Abandon extinguisher if fire persists..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• 0–30 Seconds (The Trigger):\nSound the alarm the split-second you see flames or smell strong electrical smoke. Flashover (total room engulfment) can happen in less than 3 minutes.\n\n• The 30-Second Rule (Fighting Fire):\nOnly attempt to use a fire extinguisher if the fire is small (size of a wastebasket). If the fire is not out within 30 seconds of discharging the extinguisher, abandon the attempt and run.\n\n• Post-Evacuation:\nStay at the assembly point. Inform firefighters immediately if anyone is missing or suspected to be trapped inside."
                            android:justificationMode="inter_word"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerWhy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="WHY are these steps critical?"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/arrowWhy"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewWhy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Alarm saves precious minutes. Staying low avoids toxic ceiling gas. Lifts fail during blackout..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentWhy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Why sound the alarm first?\nIf you try to fight the fire first and fail, the fire will have grown exponentially, and other occupants will lose the precious minutes needed to escape alive.\n\n• Why stay low to the floor?\nToxic smoke and superheated gases rise to the ceiling first. Inhaling just a few breaths of toxic smoke can cause instant disorientation, lung burns, or loss of consciousness.\n\n• Why close doors behind you?\nAn open door acts as a chimney, drawing in oxygen and funneling deadly carbon monoxide straight into the hallways used for evacuation.\n\n• Why avoid elevators?\nFire frequently cuts off the building's electrical power grid, which will trap occupants inside a dark lift shaft filling with toxic smoke."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:id="@+id/headerHow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/arrowHow"
                            android:layout_centerVertical="true"
                            android:text="HOW to handle the situation? (Step-by-Step)"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/arrowHow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/previewHow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="[ Step 1: Sound building alarm ] ➔ [ Step 2: Evacuate low ] ➔ [ Step 3: Call 999 outside ]..."
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contentHow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#E9ECEF"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginBottom="12dp"
                            android:text="[ Step 1: Sound building alarm ] ➔ [ Step 2: Evacuate low &amp; crawl ] ➔ [ Step 3: Call 999 outside ]"
                            android:textColor="#495057"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 1: Trigger Building Alert"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Run to the nearest red Fire Alarm Call Point (usually found near exits or stairwell doors). Firmly smash the glass or press the plastic element inward to trigger the building sirens."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Step 2: Navigate Through Dense Smoke"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Drop onto your hands and knees. Keep your head 30cm to 60cm above the floor. Cover your nose and mouth with a damp cloth or a piece of clothing to filter out ash particles."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Step 3: Fight Minor Fire (The PASS Method)"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• P (Pull): Pull the safety pin out from the handle.\n• A (Aim): Aim the nozzle low, pointing directly at the base of the fire (not the flames).\n• S (Squeeze): Squeeze the lever firmly to discharge the extinguishing agent.\n• S (Sweep): Sweep the nozzle from side to side across the base until extinguished."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Step 4: If Clothing Catches Fire (Stop, Drop, and Roll)"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STOP immediately. Do not run, as movement feeds oxygen to the fire. DROP flat onto the ground and cover your face with your hands. ROLL back and forth repeatedly until the flames are completely smothered."
                            android:textColor="#424242"
                            android:justificationMode="inter_word"
                            android:layout_marginTop="4dp"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="20dp"
                android:text="© 2026 JER - Chia Jing Xian. All rights reserved."
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>